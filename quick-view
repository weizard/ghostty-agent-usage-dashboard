#!/usr/bin/env python3
"""Full-surface quota panel for Ghostty's quick terminal.

Summoned by a global hotkey, so it redraws while open and exits on Esc or q —
the surface closes with it, which is how the panel dismisses. A refresh that
fails is shown in place: the panel outliving a bad reading matters more than
reporting it loudly.
"""

import errno
import json
import os
import re
import select
import signal
import subprocess
import sys
import termios
import time
import tty
from pathlib import Path

HERE = Path(__file__).resolve().parent
READER = HERE / "agent-usage"
REFRESH = 5
STALE_AFTER = 1800
BAR = 22

R = "\033[0m"
DIM = "\033[38;5;245m"
LABEL = "\033[38;5;252m"
OK = "\033[38;5;114m"
WARN = "\033[38;5;179m"
HOT = "\033[38;5;174m"
VOID = "\033[38;5;240m"

NAMES = {"CC": "Claude Code", "CX": "Codex"}
STATES = ("ok", "expired", "missing")
CONTROL = re.compile(r"[\x00-\x1f\x7f-\x9f]")


def numeric_or_none(value):
    """A field the panel does arithmetic on must be a number or absent."""
    return value is None or (not isinstance(value, bool) and isinstance(value, (int, float)))


def sanitize(text):
    """A source-derived string must not carry escape sequences to the screen."""
    return CONTROL.sub("", text) if isinstance(text, str) else text


def colour(pct):
    if pct is None:
        return VOID
    return HOT if pct >= 75 else WARN if pct >= 50 else OK


def left(resets_at):
    if not resets_at:
        return ""
    secs = int(resets_at - time.time())
    if secs <= 0:
        return "resetting"
    if secs >= 86400:
        return "%dd %dh" % (secs // 86400, secs % 86400 // 3600)
    if secs >= 3600:
        return "%dh %02dm" % (secs // 3600, secs % 3600 // 60)
    return "%dm" % (secs // 60)


def bar(pct):
    if pct is None:
        return VOID + "·" * BAR + R
    filled = min(BAR, int(round(pct / 100 * BAR)))
    return colour(pct) + "█" * filled + DIM + "░" * (BAR - filled) + R


def read():
    result = subprocess.run([sys.executable, str(READER), "--format", "json",
                             "--stale-after", str(STALE_AFTER)],
                            capture_output=True, text=True)
    if result.returncode != 0:
        error = result.stderr.strip().splitlines()
        raise RuntimeError(error[-1] if error else "reader failed")
    return json.loads(result.stdout)


def frame():
    try:
        return usage_frame(read())
    except Exception as exc:                          # keep the panel up
        return ["", "  %scannot read usage: %s%s" % (HOT, sanitize(str(exc)), R), "",
                "  %sEsc / q close   ·   s shell%s" % (DIM, R)]


def usage_frame(data):
    out = ["", ""]
    for label, agent in data.items():
        model = agent.get("model")
        out.append("  %s%s%s%s" % (LABEL, NAMES.get(label, label), R,
                                   "  %s·  %s%s" % (VOID, sanitize(model), R) if model else ""))
        windows = [agent.get(slot) for slot in ("short_window", "long_window")]
        # A panel left running across an upgrade would otherwise render every
        # window as absent instead of saying it cannot read this, so the shape
        # is checked down to the fields it reads, not just the outer keys.
        if not all(isinstance(w, dict) and w.get("state") in STATES
                   and numeric_or_none(w.get("used_pct"))
                   and numeric_or_none(w.get("resets_at")) for w in windows):
            out.append("     %sreader output not understood — press q and"
                       " summon the panel again%s" % (HOT, R))
            out.append("")
            continue
        if agent.get("error"):
            out.append("     %s%s%s" % (VOID, sanitize(agent["error"]), R))
            out.append("")
            continue
        for slot in ("short_window", "long_window"):
            window = agent.get(slot) or {}
            name = sanitize(window.get("label")) or "–"
            state, pct = window.get("state"), window.get("used_pct")
            if state == "expired":
                note = "window has reset since"
            elif state == "missing":
                note = "not reported"
            else:
                note = left(window.get("resets_at"))
            shown = "  –" if pct is None else "%3d%%" % round(pct)
            out.append("     %s%s%s  %s  %s%s%s   %s%s%s"
                       % (DIM, name, R, bar(pct), colour(pct), shown, R, DIM, note, R))
        if agent.get("stale"):
            age = agent.get("age_seconds") or 0
            since = ("%dh%02dm" % (age // 3600, age % 3600 // 60) if age >= 7200
                     else "%dm" % (age // 60) if age else "")
            if agent.get("clock_skew"):
                out.append("     %s↑ timestamp is ahead of this clock%s" % (VOID, R))
                out.append("")
                continue
            description = {"last_change": "last change", "observation": "last observed"}.get(
                agent.get("age_kind"), "snapshot from")
            out.append("     %s↑ %s %s ago%s" % (VOID, description, since, R)
                       if since else "     %s↑ no reading yet%s" % (VOID, R))
        out.append("")
    out.append("  %sEsc / q close   ·   s shell (exit returns here)   ·   every %ds%s"
               % (DIM, REFRESH, R))
    return out


def retry_termios(action, *args):
    # Terminal attribute calls can be interrupted by unrelated signals.
    while True:
        try:
            return action(*args)
        except termios.error as exc:
            if exc.args[0] != errno.EINTR:
                raise


class Screen:
    """Cbreak mode and a hidden cursor, restored whatever ends the panel."""

    def __init__(self, fd):
        self.fd = fd
        self.saved = termios.tcgetattr(fd)

    def enter(self):
        retry_termios(tty.setcbreak, self.fd)
        sys.stdout.write("\033[?25l")
        sys.stdout.flush()

    def leave(self):
        # Independent attempts: a failed tcsetattr must not strand the cursor.
        try:
            retry_termios(termios.tcsetattr, self.fd, termios.TCSADRAIN, self.saved)
        except termios.error:
            pass
        finally:
            try:
                sys.stdout.write("\033[?25h\033[2J\033[H")
                sys.stdout.flush()
            except Exception:
                pass


def main():
    if not sys.stdin.isatty():
        print("\n".join(frame()))
        return 0

    screen = Screen(sys.stdin.fileno())

    def on_terminate(signum, _frame):
        screen.leave()
        signal.signal(signum, signal.SIG_DFL)
        os.kill(os.getpid(), signum)

    def draw():
        sys.stdout.write("\033[2J\033[H" + "\n".join(frame()))
        sys.stdout.flush()

    def on_suspend(signum, _frame):
        suspended = {signal.SIGTSTP}
        previous_mask = signal.pthread_sigmask(signal.SIG_BLOCK, suspended)
        try:
            screen.leave()
            signal.signal(signal.SIGTSTP, signal.SIG_DFL)
            os.kill(os.getpid(), signal.SIGTSTP)
            # Deliver the default stop; a blocked signal cannot suspend us.
            signal.pthread_sigmask(signal.SIG_UNBLOCK, suspended)
            signal.pthread_sigmask(signal.SIG_BLOCK, suspended)

            # Orphaned groups discard the stop, so restore on either return.
            screen.enter()
            draw()
        finally:
            signal.signal(signal.SIGTSTP, on_suspend)
            signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)

    signal.signal(signal.SIGTERM, on_terminate)
    signal.signal(signal.SIGHUP, on_terminate)
    signal.signal(signal.SIGTSTP, on_suspend)

    try:
        screen.enter()
        while True:
            draw()
            ready = select.select([screen.fd], [], [], REFRESH)[0]
            if not ready:
                continue
            key = os.read(screen.fd, 3)
            if key in (b"\x1b", b"q", b"\x04"):
                return 0
            if key == b"s":
                # The shell runs as a child, so leaving it returns to the panel.
                # The marker the shell hook keys on is dropped, or that shell
                # would hand straight back here.
                screen.leave()
                env = dict(os.environ)
                env.pop("GHOSTTY_QUICK_TERMINAL", None)
                shell = env.get("SHELL", "/bin/sh")
                try:
                    subprocess.call([shell, "-i"], env=env)
                except OSError:
                    pass
                screen.enter()
    except KeyboardInterrupt:
        return 0
    finally:
        screen.leave()


if __name__ == "__main__":
    sys.exit(main())
